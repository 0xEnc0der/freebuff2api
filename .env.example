# Codebuff / Freebuff upstream Bearer token.
# Required. Source is the Authorization: Bearer <token> from HAR or client requests.
# Only fill in the token itself, do not include the "Bearer " prefix.
# Multiple accounts can be separated with commas; concurrent requests will be automatically distributed to idle accounts.
# Example: FREEBUFF_TOKEN=token-a,token-b,token-c
FREEBUFF_TOKEN=

# Local OpenAI-compatible API access key.
# Optional. Leave empty to skip authorization check on local endpoints.
# If filled, e.g., FREEBUFF_API_KEY=sk-local, calls to this project must include:
# Authorization: Bearer sk-local
FREEBUFF_API_KEY=

# Freebuff upstream API base URL
FREEBUFF_API_BASE_URL=https://www.codebuff.com

# Ad provider request order.
# The project will request /api/v1/ads in order, exchange the ad impression for a freebuff session.
# gravity may return empty ads in HAR, zeroclick returns usable impressions.
FREEBUFF_AD_PROVIDERS=gravity,zeroclick

# Upstream HTTP request timeout in seconds.
# Stream conversation read timeout is separately increased, this mainly affects normal requests.
FREEBUFF_TIMEOUT=60

# Whether to enable upstream proxy.
# false: All upstream requests are direct connections and do not read system HTTP_PROXY / HTTPS_PROXY.
# true: All upstream requests go through FREEBUFF_PROXY_URL.
FREEBUFF_PROXY_ENABLED=false

# Upstream proxy URL.
# Supports http://, https://, socks5://, socks5h://.
# Example: http://127.0.0.1:7890 or socks5://127.0.0.1:1080
FREEBUFF_PROXY_URL=

# Debug mode.
# false: Only output key operation logs.
# true: Output upstream requests/responses, raw SSE lines, OpenAI-converted chunks, finalize exceptions and other detailed information.
FREEBUFF_DEBUG=false

# Log level.
# Common values: DEBUG, INFO, WARNING, ERROR.
# When FREEBUFF_DEBUG=true is enabled, it defaults to DEBUG.
FREEBUFF_LOG_LEVEL=INFO

# Maximum number of characters to print in request/response body in logs.
# 0 means no truncation; can be set to 0 when debugging complex issues.
FREEBUFF_LOG_BODY_CHARS=2000

# Whether to enable colored logs.
# true: Output ANSI colors according to log level.
# false: Plain text logs, suitable for writing to files or terminals that don't support ANSI.
FREEBUFF_LOG_COLOR=true

# Service listening address.
# Default 0.0.0.0, keep default for container environments or when external access is needed.
# For local testing, it is recommended to set to 127.0.0.1.
FREEBUFF_HOST=0.0.0.0

# Service listening port.
# Default 8000.
FREEBUFF_PORT=8000

# Simulate client device information: timezone.
# HAR uses Asia/Shanghai.
FREEBUFF_TIMEZONE=Asia/Shanghai

# Simulate client device information: language locale.
# HAR uses zh-CN.
FREEBUFF_LOCALE=zh-CN

# Simulate client device information: operating system.
# HAR uses windows.
FREEBUFF_OS=windows
